{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["app/components/*"],
      "@config/*": ["app/config/*"],
      "@constants/*": ["app/constants/*"],
      "@contexts/*": ["app/contexts/*"],
      "@hooks/*": ["app/hooks/*"],
      "@providers/*": ["app/providers/*"],
      "@utils/*": ["app/utils/*"],
      "@features/*": ["features/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
