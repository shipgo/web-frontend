# Variables de entorno del frontend (Vite). Copiar a `.env` y completar.
# Sólo las claves con prefijo VITE_ quedan expuestas al bundle del navegador.

# Mapbox — mapas en vivo y autocompletado de direcciones.
VITE_MAPBOX_API_KEY=

# OneSignal — push web (SHG-FE-027). App ID del panel de OneSignal.
# Opcional: sin esta clave, la campana de notificaciones funciona sólo in-app
# (polling), sin push del navegador.
VITE_ONESIGNAL_APP_ID=

# Cloudflare Turnstile — captcha en las superficies públicas con costo (login,
# tracking guest, self-signup CUSTOMER, arranque de recuperar contraseña).
# SHG-FE-043 / contrato SHG-BE-032 (`planning/coordination/frontend.md`).
# Site key PÚBLICA (no es secreta, va al bundle) del proyecto real:
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEtX1h9dBGTRgdlr
# Flag para desactivar el captcha por completo (dev/CI/e2e) sin tocar código.
# Si se omite, se desactiva solo bajo Vitest y queda activo en todo lo demás.
# VITE_TURNSTILE_ENABLED=false
