# Variables de entorno del frontend (Vite). Copiar a `.env` y completar.
# Sólo las claves con prefijo VITE_ quedan expuestas al bundle del navegador.

# Mapbox — mapas en vivo y autocompletado de direcciones.
VITE_MAPBOX_API_KEY=

# OneSignal — push web (SHG-FE-027). App ID del panel de OneSignal.
# Opcional: sin esta clave, la campana de notificaciones funciona sólo in-app
# (polling), sin push del navegador.
VITE_ONESIGNAL_APP_ID=
